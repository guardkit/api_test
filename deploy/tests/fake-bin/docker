#!/usr/bin/env bash
#
# Fake `docker` for the deploy.sh dry-run harness. Records every invocation to
# $FAKE_DOCKER_LOG and models a tiny image-tag store ($FAKE_DOCKER_STATE) so
# `docker tag` / `docker image inspect` behave enough like the real thing to
# exercise deploy.sh's snapshot / re-tag / not-found logic.
# `docker compose ...` is recorded and always succeeds. NEVER touches real docker.
#
# A TAG IS AN ALIAS, NOT A COPY (23 September 2026). Each line of the store is
# "<ref> <id>", and `docker tag src dst` gives dst SRC'S OWN id — which is what
# real docker does, and what the promote's read-back depends on: it asks
# whether the live tag and the identity's own tag are THE SAME IMAGE, and the
# answer is only meaningful if two tags of one image share an id. A seeded ref
# with no id written beside it gets one derived from its own name, so the
# harness's `SEED_IMAGES="a b c"` line is unchanged.
set -u

LOG="${FAKE_DOCKER_LOG:?FAKE_DOCKER_LOG unset}"
STATE="${FAKE_DOCKER_STATE:?FAKE_DOCKER_STATE unset}"
printf 'docker %s\n' "$*" >>"${LOG}"

# The id recorded for a ref, or empty when nothing knows it. A line with no id
# beside it is a seeded image and gets one made from its own name.
#
# AN ID IS ALSO A REF (24 September 2026). Real docker resolves an image id the
# same way it resolves a tag, and that is the whole point of the promote's cure:
# the recorded artifact is handed back as an ID and resolved as one, never
# through the shared candidate tag. So a lookup that matches no ref is tried
# again against every id in the store.
id_of() {
  local line escaped
  escaped="$(printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g')"
  line="$(grep -m1 -E "^${escaped}( |$)" "${STATE}" 2>/dev/null || true)"
  if [[ -n "${line}" ]]; then
    if [[ "${line}" == *" "* ]]; then
      printf '%s\n' "${line#* }"
    else
      printf 'sha256:fake-%s\n' "$(printf '%s' "$1" | tr '/:' '__')"
    fi
    return 0
  fi
  # Not a ref. Is it an id something in the store points at?
  while IFS= read -r line; do
    [[ -z "${line}" ]] && continue
    if [[ "${line}" == *" "* && "${line#* }" == "$1" ]]; then
      printf '%s\n' "$1"
      return 0
    fi
    if [[ "${line}" != *" "* ]]; then
      if [[ "sha256:fake-$(printf '%s' "${line}" | tr '/:' '__')" == "$1" ]]; then
        printf '%s\n' "$1"
        return 0
      fi
    fi
  done <"${STATE}"
  return 1
}

known() { id_of "$1" >/dev/null 2>&1; }

# Point ref at id. An existing line for that ref is replaced, because a tag
# that is moved onto another image points at the new one.
put() {
  local ref="$1" id="$2" escaped
  escaped="$(printf '%s' "${ref}" | sed 's/[][\.*^$/]/\\&/g')"
  if [[ -f "${STATE}" ]]; then
    grep -v -E "^${escaped}( |$)" "${STATE}" > "${STATE}.next" 2>/dev/null || true
    mv "${STATE}.next" "${STATE}"
  fi
  printf '%s %s\n' "${ref}" "${id}" >>"${STATE}"
}

#: The container the LIVE compose project runs its app service in. One is
#: enough for this harness; its line in the store is "container:<id> <image id>",
#: written when `compose up` runs on the live project and read by
#: `docker inspect`, which is how deploy.sh now finds out what is RUNNING
#: rather than what a tag happens to point at today.
LIVE_CONTAINER="${FAKE_LIVE_CONTAINER:-apitest-f2-app-1}"
LIVE_PROJECT="${FAKE_LIVE_PROJECT:-apitest-f2}"

# EVERY compose project has a container here now, not only the live one (25
# September 2026). The candidate check reads the image off the container IT
# started, so a harness that models containers for the live project alone
# cannot exercise the thing being proved. A non-live project's `up --build`
# makes its own image, <project>-app:latest, exactly as compose does.
container_of_project() { printf 'container:%s-app-1\n' "$1"; }

# `docker compose ... ps` FAILS while this is set, so a failed observation can
# be driven rather than described: it is the fault the third review found, in
# which the script turned a failing docker into "nothing is running".
FAIL_PS="${FAKE_DOCKER_PS_FAILS:-}"

case "${1:-}" in
  image)
    # docker image inspect --format <fmt> <ref>. Two formats are modelled:
    #   {{.Id}}                 -> the image's own id
    #   {{range .RepoTags}}...  -> every ref in the store sharing that id
    if [[ "${2:-}" == "inspect" ]]; then
      ref=""
      for a in "$@"; do ref="$a"; done # last arg is the ref
      fmt=""
      prev=""
      for a in "$@"; do
        if [[ "${prev}" == "--format" ]]; then fmt="$a"; fi
        prev="$a"
      done
      if ! this_id="$(id_of "${ref}")"; then
        exit 1 # absent -> non-zero, like real docker
      fi
      if [[ "${fmt}" == *RepoTags* ]]; then
        # Every ref sharing this id, one per line — what real docker's RepoTags
        # range prints. Each line is resolved the way id_of does, because a
        # seeded ref with no id beside it derives one from its own name.
        while IFS= read -r line; do
          [[ -z "${line}" ]] && continue
          other="${line%% *}"
          case "${other}" in container:*) continue ;; esac
          other_id="$(id_of "${other}")" || continue
          [[ "${other_id}" == "${this_id}" ]] && printf '%s\n' "${other}"
        done <"${STATE}"
        exit 0
      fi
      printf '%s\n' "${this_id}"
      exit 0
    fi
    ;;
  inspect)
    # docker inspect --format '{{.Image}}' <container id> — what the CONTAINER
    # was started from. A tag can be moved onto another image after a container
    # started; this cannot, which is why the promote's confirmation reads it.
    #
    # $FAKE_DOCKER_INSPECT_FAILS makes this fail, so "something is up and
    # cannot be asked what it is running" can be driven too.
    if [[ -n "${FAKE_DOCKER_INSPECT_FAILS:-}" ]]; then
      printf 'Error response from daemon: dial unix docker.raw.sock: no such file\n' >&2
      exit 1
    fi
    cid=""
    for a in "$@"; do cid="$a"; done
    if id_of "container:${cid}"; then
      exit 0
    fi
    exit 1
    ;;
  tag)
    src="${2:?}"
    dst="${3:?}"
    if src_id="$(id_of "${src}")"; then
      put "${dst}" "${src_id}"
      exit 0
    fi
    printf 'Error response from daemon: No such image: %s\n' "${src}" >&2
    exit 1
    ;;
  compose)
    # Which project, and which verb? EVERY project has a container modelled,
    # because the candidate check reads the image off the container it started.
    project=""
    prev=""
    verb=""
    builds=""
    for a in "$@"; do
      if [[ "${prev}" == "-p" ]]; then project="$a"; fi
      case "$a" in up | down | ps | ls) [[ -z "${verb}" ]] && verb="$a" ;; esac
      case "$a" in --build) builds=1 ;; esac
      prev="$a"
    done
    # `docker compose ls --all -q` — the projects that have something up. Read
    # off the container lines, which is where this harness keeps them.
    if [[ "${verb}" == "ls" ]]; then
      while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        ref="${line%% *}"
        case "${ref}" in container:*) ;; *) continue ;; esac
        name="${ref#container:}"
        printf '%s\n' "${name%-app-1}"
      done <"${STATE}"
      exit 0
    fi
    [[ -z "${project}" ]] && exit 0
    if [[ "${project}" == "${LIVE_PROJECT}" ]]; then
      this_container="container:${LIVE_CONTAINER}"
      this_image="${FAKE_LIVE_IMAGE:-apitest-f2-app:latest}"
    else
      this_container="$(container_of_project "${project}")"
      this_image="${project}-app:latest"
    fi
    case "${verb}" in
      up)
        # The container is (re)created from whatever this project's image names
        # NOW. `--build` makes that image first, as compose does.
        if [[ -n "${builds}" ]] && ! known "${this_image}"; then
          put "${this_image}" "sha256:fake-$(printf '%s' "${this_image}" | tr '/:' '__')"
        fi
        if this_id="$(id_of "${this_image}")"; then
          put "${this_container}" "${this_id}"
        fi
        ;;
      ps)
        # `ps -q app` — the container id, or nothing when none is up. A DOCKER
        # THAT FAILS says so on stderr and exits non-zero; it never answers.
        if [[ -n "${FAIL_PS}" ]]; then
          printf 'Cannot connect to the Docker daemon. Is the docker daemon running?\n' >&2
          exit 1
        fi
        if id_of "${this_container}" >/dev/null 2>&1; then
          printf '%s\n' "${this_container#container:}"
        fi
        ;;
      down)
        escaped="$(printf '%s' "${this_container}" | sed 's/[][\.*^$/]/\\&/g')"
        grep -v -E "^${escaped}( |$)" "${STATE}" >"${STATE}.next" 2>/dev/null || true
        mv "${STATE}.next" "${STATE}"
        ;;
    esac
    exit 0
    ;;
esac
exit 0
